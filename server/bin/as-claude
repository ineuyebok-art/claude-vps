#!/usr/bin/python3 -I
"""Единственный способ бота действовать от имени claude: sudo -u claude as-claude <команда>."""
import os
import re
import sys
import tempfile
from pathlib import Path

HOME = Path(os.environ.get("CCVPS_HOME") or Path("/home/claude"))
CLAUDE_MD = HOME / ".claude" / "CLAUDE.md"
SYS_START, SYS_END = "<!-- claude-vps:system:start -->", "<!-- claude-vps:system:end -->"
USER_START, USER_END = "<!-- claude-vps:user:start -->", "<!-- claude-vps:user:end -->"


def fail(msg, code=2):
    print(msg, file=sys.stderr)
    sys.exit(code)


def atomic_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(tmp, 0o644)
    os.rename(tmp, path)


def md_parts():
    """Разбирает CLAUDE.md на системную часть, «Мои инструкции» и всё остальное."""
    text = CLAUDE_MD.read_text(encoding="utf-8") if CLAUDE_MD.exists() else ""
    sys_re = re.compile(re.escape(SYS_START) + r".*?" + re.escape(SYS_END), re.S)
    user_re = re.compile(re.escape(USER_START) + r"(.*?)" + re.escape(USER_END), re.S)
    m = user_re.search(text)
    user = m.group(1).strip() if m else ""
    rest = user_re.sub("", sys_re.sub("", text))
    rest = re.sub(r"^## Мои инструкции\s*$", "", rest, flags=re.M).strip()
    system = ""
    m = sys_re.search(text)
    if m:
        system = m.group(0)
    return system, user, rest


def md_join(system, user, rest):
    parts = [system, "## Мои инструкции\n" + USER_START + "\n" + user + "\n" + USER_END]
    if rest:
        parts.append(rest)
    return "\n\n".join(p for p in parts if p) + "\n"


def claude_md_system():
    body = sys.stdin.read().strip()
    _, user, rest = md_parts()
    atomic_write(CLAUDE_MD, md_join(f"{SYS_START}\n{body}\n{SYS_END}", user, rest))


def instructions_get():
    print(md_parts()[1])


def instructions_set():
    system, _, rest = md_parts()
    atomic_write(CLAUDE_MD, md_join(system, sys.stdin.read().strip(), rest))


COMMANDS = {
    "claude-md-system": claude_md_system,
    "instructions-get": instructions_get,
    "instructions-set": instructions_set,
}


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd not in COMMANDS:
        fail("Неизвестная команда: " + cmd)
    COMMANDS[cmd]()


if __name__ == "__main__":
    main()
